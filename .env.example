# ── Client-side (Vite, exposed to browser) ────────────────────────────────────
# Get from: https://supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# VAPID public key for push notifications (must match VAPID_PUBLIC_KEY below)
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# ── Server-side (Vercel / Node, never exposed to browser) ─────────────────────
# Supabase service role key — full DB access, keep secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# VAPID keys for web-push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# Cron secret — protects /api/send-reminders from unauthorized triggers
# Set this in Vercel Dashboard → Settings → Environment Variables
# Then configure Vercel Cron in vercel.json with Authorization: Bearer <value>
CRON_SECRET=your-random-secret-here
